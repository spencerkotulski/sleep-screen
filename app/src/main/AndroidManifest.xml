<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 12+: the timer fires on the minute; without it the alarm may come a few minutes late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 10 and later only let an app open the warning from the background when it may draw over other
         apps. the install script grants it; on Android 9 it is not needed. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Show the device's Settings activities in the alternate setup picker. -->
    <queries>
        <package android:name="com.android.settings" />
        <package android:name="com.android.tv.settings" />
        <package android:name="com.google.android.tv.settings" />
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name">

        <receiver android:name=".ScheduleBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- The quick bar, for a remote button: map it in the launcher's app_keys as
             hold:<keycode>:app.sleepscreen.tv/.QuickActivity. The tile and the card open the picker. -->
        <activity
            android:name=".QuickActivity"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".UpdateActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity android:name=".SetupActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity android:name=".SettingsPickerActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity android:name=".MapperActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <service android:name=".RemoteService" android:exported="true" android:label="Sleep Screen Remote" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"><intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter><meta-data android:name="android.accessibilityservice" android:resource="@xml/remote_service" /></service>
        <activity android:name=".OverlaySettingsActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- Bedtime in one press: a 30-minute timer plus Brightness's night mode, off again on the next press. -->
        <activity
            android:name=".BedtimeActivity"
            android:taskAffinity=""
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Weekly wake/sleep events and date exclusions, edited with the remote. -->
        <activity
            android:name=".ScheduleActivity"
            android:taskAffinity=""
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- The timer picker: the app's own tile and, on the cleanyourtv launcher, its module card. -->
        <activity
            android:name=".TimerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        </activity>

        <!-- The last minute: a countdown over whatever is playing, with "15 more minutes" and "Now". -->
        <activity
            android:name=".WarningActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Warning" />

        <!-- Exported only to callers holding WRITE_SECURE_SETTINGS (the adb shell), for the TEST action. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- Its only job is the "lock screen" global action, which on Android 9 and later puts the TV to sleep: an
             ordinary app has no other way to. It asks for no events and cannot read the screen. -->
        <service
            android:name=".SleepService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/sleep_service" />
        </service>
    </application>
</manifest>

